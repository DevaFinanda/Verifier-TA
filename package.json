{
  "name": "verifier-app",
  "version": "1.0.0",
  "description": "BPJS Verifier Application - Frontend & Backend",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" --names \"backend,frontend\" --prefix-colors \"blue,magenta\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend1 && pnpm dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend1 && pnpm build",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\" --names \"backend,frontend\" --prefix-colors \"blue,magenta\"",
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd frontend1 && pnpm start",
    "install:all": "cd backend && npm install && cd ../frontend1 && pnpm install",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:restart": "docker-compose restart",
    "docker:clean": "docker-compose down -v && docker system prune -f"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "",
  "license": "ISC"
}
